{
  "name": "opencode-subway-surfers",
  "version": "0.1.0",
  "description": "OpenCode TUI plugin that pauses the Subway Surfers Tauri wrapper when the agent waits for a prompt (with no background shells) and resumes when it works.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "subway-surfers",
    "tauri",
    "autopause"
  ],
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.3.0"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.3.0",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
